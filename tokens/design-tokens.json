  "semantic": {
    "$type": "color",
    "$description": "Semantic aliases — components use ONLY these. Every fg/bg combination used must be a PASS row in docs/brand.md §2.5.",
    "bg": {
      "canvas": {
        "$value": "{color.white}"
      },
      "subtle": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.100}"
      },
      "brand-subtle": {
        "$value": "{color.primary.50}"
      },
      "brand": {
        "$value": "{color.primary.800}",
        "$description": "Hero/CTA band with white text."
      },
      "brand-strong": {
        "$value": "{color.primary.900}"
      },
      "inverse": {
        "$value": "{color.neutral.950}",
        "$description": "Footer."
      }
    },
    "fg": {
      "default": {
        "$value": "{color.neutral.900}"
      },
      "strong": {
        "$value": "{color.neutral.950}"
      },
      "muted": {
        "$value": "{color.neutral.700}"
      },
      "hint": {
        "$value": "{color.neutral.600}",
        "$description": "Lightest grey allowed for text on white."
      },
      "disabled": {
        "$value": "{color.neutral.400}",
        "$description": "Disabled only (exempt). Never readable text."
      },
      "brand": {
        "$value": "{color.primary.700}",
        "$description": "Brand-coloured text, eyebrows."
      },
      "brand-display": {
        "$value": "{color.brand.green}",
        "$description": "Logo green for display text ≥24px (or ≥18.66px bold) on canvas only."
      },
      "inverse": {
        "$value": "{color.white}"
      },
      "inverse-muted": {
        "$value": "{color.neutral.200}"
      },
      "on-brand": {
        "$value": "{color.white}"
      },
      "on-brand-muted": {
        "$value": "{color.primary.100}"
      }
    },
    "border": {
      "decorative": {
        "$value": "{color.neutral.200}",
        "$description": "Dividers only — not input boundaries."
      },
      "input": {
        "$value": "{color.neutral.500}",
        "$description": "≥3:1 vs canvas (1.4.11)."
      },
      "brand": {
        "$value": "{color.primary.700}"
      },
      "rule": {
        "$value": "{color.brand.green}",
        "$description": "Logo-motif horizontal rule (decorative)."

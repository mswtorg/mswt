  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Poppins",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Default UI, body and heading face for Latin and Devanagari (owner decision 2026-10-21; SIL OFL 1.1). Admins can switch the site font in Settings → Appearance (see docs/spec.md)."
      },
      "devanagari": {
        "$value": [
          "Poppins",
          "Noto Sans Devanagari",
          "sans-serif"
        ],
        "$description": "Hindi + Marathi: Poppins has Devanagari; Noto Sans Devanagari (OFL) is the fallback for any glyph Poppins lacks."
      },
      "gujarati": {
        "$value": [
          "Noto Sans Gujarati",
          "sans-serif"
        ],
        "$description": "Gujarati: Poppins has no Gujarati glyphs. Noto Sans Gujarati, SIL OFL 1.1."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "base": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": {
        "$value": "0"
      },
      "caps": {
        "$value": "0.12em",
        "$description": "Uppercase eyebrows/labels, echoing the wide-tracked wordmark. Latin only — never on Indic scripts."
      }
    },
    "line-height": {
      "$type": "number",
      "latin": {
        "tight": {
          "$value": 1.2
        },
        "snug": {
          "$value": 1.35
        },
        "body": {
          "$value": 1.6,
          "$description": "Poppins has tall ascenders; 1.6 keeps body text open."
        }
      },
      "indic": {
        "$description": "Devanagari/Gujarati need room for matras and conjuncts.",
        "tight": {
          "$value": 1.4
        },
        "snug": {
          "$value": 1.55
        },
        "body": {
          "$value": 1.75
        }
      }
    }
  },

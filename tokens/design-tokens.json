      "$description": "Logo-motif rule under section headings."
    },
    "focus": {
      "$value": "3px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Flat, print-like. Separation by rules and tints first; shadows only for overlays.",
    "sm": {
      "$value": {
        "color": "#32373d1f",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "Cards on hover."
    },
    "md": {
      "$value": {
        "color": "#32373d29",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      },
      "$description": "Menus, popovers, dialogs."
    }
  },
  "size": {
    "$type": "dimension",
    "target-min": {
      "$value": "24px",
      "$description": "WCAG 2.5.8 minimum pointer target."
    },
    "target-comfortable": {
      "$value": "44px",
      "$description": "Primary controls and mobile nav."
    },
    "focus-ring-offset": {
      "$value": "2px"
    },
    "container-max": {
      "$value": "80rem"
    },
    "logo-min-horizontal": {
      "$value": "200px",
      "$description": "Smallest on-screen width of the horizontal logo (keeps WELFARE TRUST cap height ≥8px)."
    },
    "logo-min-mark": {
      "$value": "48px",
      "$description": "Below this use mswt-mark-compact.svg."
    },
    "logo-min-compact": {
      "$value": "16px"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "48rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  },
  "motion": {
    "$description": "All non-essential motion off under prefers-reduced-motion: reduce.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  },
  "pwa": {
    "$type": "color",
    "theme": {
      "$value": "{color.primary.800}",
      "$description": "manifest theme_color / meta theme-color."
    },
    "background": {
      "$value": "{color.white}",
      "$description": "manifest background_color."
    }
  }
}

{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/hi",
        "http://localhost:3000/mr",
        "http://localhost:3000/en/causes",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/en/donate",
        "http://localhost:3000/en/testimonials"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/(en|gu)/(?!donate$).+$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [

# Copy to .env.local and fill in. Never commit real values.
# Neon pooled connection string (Project → Connection details → Pooled)
DATABASE_URL=
# Public site origin used for canonical URLs, sitemap and metadataBase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for POST /api/revalidate (content:sync and the admin use it). Any long random string.
REVALIDATE_SECRET=
# Where content:sync sends the revalidate call, e.g. https://mswelfaretrust.org/api/revalidate
REVALIDATE_URL=
# Cloudflare Turnstile (contact form). Leave empty locally/previews to use Cloudflare's test keys; required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing contact-form IPs (rate limiting without storing IPs). Any long random string.
IP_HASH_SALT=

# ── Donations (Step 7). All optional locally/CI/previews: the fake gateway, local receipt files and a
# logged "memory" email are used instead. Production refuses to start a payment without them.
# Cashfree: Dashboard → Developers → API keys. Sandbox until go-live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Set to "fake" to force the test gateway (tests only; refused in production).
PAYMENT_PROVIDER=
# Cloudflare R2: a PRIVATE bucket for receipt PDFs (R2 → Manage API tokens: Object Read & Write, this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECEIPTS_BUCKET=
# A PUBLIC bucket for website photos (the same API token needs Object Read & Write on it too), and
# its public URL (R2 → bucket → Settings → Public access: r2.dev or a custom domain), no trailing slash.
R2_MEDIA_BUCKET=
R2_MEDIA_PUBLIC_URL=
# Production only (Admin → Move from stage): a READ-ONLY login to the stage database (see
# docs/manual-checks.md MP-1) and stage's public media URL, no trailing slash. Empty elsewhere.
STAGE_DATABASE_URL=
STAGE_MEDIA_PUBLIC_URL=
# Brevo transactional email. The sender must be a verified sender/domain in Brevo (SPF + DKIM).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MS Welfare Trust
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts PAN at rest. Never change it once
# real donations exist: existing PANs could no longer be decrypted.
PII_ENCRYPTION_KEY=
# Signs receipt download links (any long random string, 32+ characters).
RECEIPT_LINK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/reconcile (16+ characters).
CRON_SECRET=
# "true" in Vercel Production only at go-live (Step 12): shows Donate and accepts payments.
NEXT_PUBLIC_DONATIONS_LIVE=

# ── Admin (Step 8a). Signs admin sessions and sign-in challenges: 32+ random characters
# (`openssl rand -base64 32`). Required in production; changing it signs everyone out.
AUTH_SECRET=

{
  "name": "mswelfaretrust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "tokens": "node scripts/tokens-to-css.mjs",
    "tokens:check": "node scripts/tokens-to-css.mjs --check",
    "mockups": "node scripts/build-mockups.mjs",
    "brand:lint": "node scripts/brand-lint.mjs",
    "org:sync": "tsx scripts/org-sync.ts",
    "content:sync": "tsx scripts/content-sync.ts",
    "settings:sync": "tsx scripts/settings-sync.ts",
    "admin:create": "tsx scripts/admin-create.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.53.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "schema-dts": "2.1.0",
    "serwist": "9.5.13",
    "simple-icons": "16.34.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "@swc/core": false,
    "unrs-resolver": false,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true
  }
}
